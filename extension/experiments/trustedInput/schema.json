[
  {
    "namespace": "trustedInput",
    "description": "Browser-level (isTrusted) mouse, keyboard and wheel input, synthesized in the parent process.",
    "functions": [
      {
        "name": "openWindow",
        "type": "function",
        "async": true,
        "description": "Open a new browser window (unsynced in Zen) and return its window ID.",
        "parameters": []
      },
      {
        "name": "activeWindowId",
        "type": "function",
        "async": true,
        "description": "ID of the browser window that has Gecko focus, or -1.",
        "parameters": []
      },
      {
        "name": "activateWindow",
        "type": "function",
        "async": true,
        "description": "Give a browser window Gecko focus without raising it on screen.",
        "parameters": [{ "name": "windowId", "type": "integer" }]
      },
      {
        "name": "status",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "mouse",
        "type": "function",
        "async": true,
        "description": "Dispatch mouse events at viewport (CSS px) coordinates of a visible tab.",
        "parameters": [
          { "name": "tabId", "type": "integer" },
          {
            "name": "events",
            "type": "array",
            "items": { "type": "object", "additionalProperties": { "type": "any" } }
          }
        ]
      },
      {
        "name": "wheel",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "tabId", "type": "integer" },
          { "name": "x", "type": "number" },
          { "name": "y", "type": "number" },
          { "name": "deltaX", "type": "number" },
          { "name": "deltaY", "type": "number" }
        ]
      },
      {
        "name": "keys",
        "type": "function",
        "async": true,
        "description": "Press keys in the tab's focused element. Each key is { key, ctrlKey?, shiftKey?, altKey?, metaKey? }.",
        "parameters": [
          { "name": "tabId", "type": "integer" },
          {
            "name": "keys",
            "type": "array",
            "items": { "type": "object", "additionalProperties": { "type": "any" } }
          }
        ]
      },
      {
        "name": "text",
        "type": "function",
        "async": true,
        "description": "Type a string into the tab's focused element, one key press per character.",
        "parameters": [
          { "name": "tabId", "type": "integer" },
          { "name": "text", "type": "string" }
        ]
      },
      {
        "name": "splitView",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "tabIds", "type": "array", "items": { "type": "integer" } },
          { "name": "layout", "type": "string" }
        ]
      },
      {
        "name": "dismissPopups",
        "type": "function",
        "async": true,
        "parameters": [{ "name": "tabId", "type": "integer" }]
      },
      {
        "name": "labelWindow",
        "type": "function",
        "async": true,
        "description": "Show a label naming the window's owner in its sidebar, or remove it when text is null.",
        "parameters": [
          { "name": "windowId", "type": "integer" },
          { "name": "text", "type": "string", "optional": true },
          { "name": "tooltip", "type": "string", "optional": true }
        ]
      }
    ],
    "events": [
      {
        "name": "onWindowLabelClicked",
        "type": "function",
        "description": "The user clicked a window's label.",
        "parameters": [{ "name": "windowId", "type": "integer" }]
      }
    ]
  }
]
