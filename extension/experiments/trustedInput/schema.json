[
  {
    "namespace": "trustedInput",
    "description": "Browser-level (isTrusted) mouse, keyboard and wheel input, synthesized in the parent process.",
    "functions": [
      {
        "name": "freeShortcut",
        "type": "function",
        "async": true,
        "description": "Disable the browser's own key for a shortcut in every window, now and later, so an extension command can use it.",
        "parameters": [
          {
            "name": "key",
            "type": "string"
          },
          {
            "name": "modifiers",
            "type": "string"
          }
        ]
      },
      {
        "name": "openWindow",
        "type": "function",
        "async": true,
        "description": "Open a new browser window (unsynced in Zen) and return its window ID.",
        "parameters": []
      },
      {
        "name": "activeWindowId",
        "type": "function",
        "async": true,
        "description": "ID of the browser window that has Gecko focus, or -1.",
        "parameters": []
      },
      {
        "name": "activateWindow",
        "type": "function",
        "async": true,
        "description": "Give a browser window Gecko focus without raising it on screen.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          }
        ]
      },
      {
        "name": "keepExternalLinksOut",
        "type": "function",
        "async": true,
        "description": "Make links opened from other apps skip this window and open in the user's most recent other window.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          }
        ]
      },
      {
        "name": "installXpi",
        "type": "function",
        "async": true,
        "description": "Replace this add-on with the package at an absolute path, which reloads it.",
        "parameters": [
          {
            "name": "path",
            "type": "string"
          }
        ]
      },
      {
        "name": "role",
        "type": "function",
        "async": true,
        "description": "Which Zen this is: \"agents\" (the profile for agents' windows) or \"user\".",
        "parameters": []
      },
      {
        "name": "setDockBadge",
        "type": "function",
        "async": true,
        "description": "Show text on the app's Dock icon (macOS); \"\" removes it.",
        "parameters": [
          {
            "name": "text",
            "type": "string"
          }
        ]
      },
      {
        "name": "activateApp",
        "type": "function",
        "async": true,
        "description": "Bring this app to the front (macOS).",
        "parameters": []
      },
      {
        "name": "status",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "mouse",
        "type": "function",
        "async": true,
        "description": "Dispatch mouse events at viewport (CSS px) coordinates of a visible tab.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          },
          {
            "name": "events",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "any"
              }
            }
          }
        ]
      },
      {
        "name": "wheel",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          },
          {
            "name": "x",
            "type": "number"
          },
          {
            "name": "y",
            "type": "number"
          },
          {
            "name": "deltaX",
            "type": "number"
          },
          {
            "name": "deltaY",
            "type": "number"
          }
        ]
      },
      {
        "name": "keys",
        "type": "function",
        "async": true,
        "description": "Press keys in the tab's focused element. Each key is { key, ctrlKey?, shiftKey?, altKey?, metaKey? }.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          },
          {
            "name": "keys",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "any"
              }
            }
          }
        ]
      },
      {
        "name": "text",
        "type": "function",
        "async": true,
        "description": "Type a string into the tab's focused element, one key press per character.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          },
          {
            "name": "text",
            "type": "string"
          }
        ]
      },
      {
        "name": "splitView",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "tabIds",
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          {
            "name": "layout",
            "type": "string"
          }
        ]
      },
      {
        "name": "dismissPopups",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          }
        ]
      },
      {
        "name": "labelWindow",
        "type": "function",
        "async": true,
        "description": "Show a label naming the window's owner in its sidebar, or remove it when text is null.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          },
          {
            "name": "text",
            "type": "string",
            "optional": true
          },
          {
            "name": "tooltip",
            "type": "string",
            "optional": true
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onWindowLabelClicked",
        "type": "function",
        "description": "The user clicked a window's label.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          }
        ]
      }
    ]
  }
]
